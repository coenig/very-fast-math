DEFINE
ego_pressured_from_ahead_on_own_lane   := ego.gaps___619___.i_agent_front != empty_gap_indicator;
ego_pressured_from_ahead_on_left_lane  := ego.gaps___609___.i_agent_front != empty_gap_indicator & (ego.gaps___609___.turn_signals_front = ActionDir____RIGHT | ego.mode = ActionType____LANECHANGE_LEFT);
ego_pressured_from_ahead_on_right_lane := ego.gaps___629___.i_agent_front != empty_gap_indicator & (ego.gaps___629___.turn_signals_front = ActionDir____LEFT );



DEFINE
   allowed_ego_a_front_center := max(min( ego.gaps___619___.s_dist_front + ego.gaps___619___.v_front + ego.gaps___619___.a_front - ego.v - ego.following_dist, ego.max_accel), ego.min_accel);
   allowed_ego_a_front_right := max(min( ego.gaps___629___.s_dist_front + ego.gaps___629___.v_front + ego.gaps___629___.a_front - ego.v - ego.following_dist, ego.max_accel), ego.min_accel);
   allowed_ego_a_front_left := max(min( ego.gaps___609___.s_dist_front + ego.gaps___609___.v_front + ego.gaps___609___.a_front - ego.v - ego.following_dist, ego.max_accel), ego.min_accel);


   -- we need to control speed if a) there is a vehicle on our lane in front (gap[1]) or b) there is a vehicle on the left lane indicating a lane change to our lane (gap[0])
   -- or c) there is a vehicle on the right lane indicating a lane change to our lane (gap[2])
   -- for distances less than 10 m, we go for max brake (or to 0), in all other cases, we take the minimum of the accel allowed by the three cases listed above
