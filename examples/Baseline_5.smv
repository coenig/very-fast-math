                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_0_of_section_2 = 1 & veh___609___.next_abs_pos > section_2_end : {0, 1};
                      veh___609___.is_on_sec_1 = 1 & outgoing_connection_0_of_section_2 = 1 & veh___609___.next_abs_pos < 0 : {0, 1};
                   -- TODO: Only add case if lane allows traversal in that direction
                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_1_of_section_2 = 1 & veh___609___.next_abs_pos > section_2_end : {0, 1};
                      veh___609___.is_on_sec_1 = 1 & outgoing_connection_1_of_section_2 = 1 & veh___609___.next_abs_pos < 0 : {0, 1};
                   

                   

                      veh___609___.is_traversing_from_sec_2_to_sec_1 = 1 & veh___609___.lane_0 & (veh___609___.next_abs_pos > arclength_from_sec_2_to_sec_1_on_lane_0 | veh___609___.next_abs_pos < 0) : 0; -- Leave this junction when passed over the end.
                   
                   TRUE : veh___609___.is_traversing_from_sec_2_to_sec_1; -- Stay on this junction as long as not passed over the end.
                esac;
             
       next(veh___609___.is_traversing_from_sec_0_to_sec_2) := case
                   -- Regular switch from end of straight section to one of subsequential junctions.
                   -- TODO: Only add case if lane allows traversal in that direction
                      veh___609___.is_on_sec_0 = 1 & outgoing_connection_0_of_section_0 = 2 & veh___609___.next_abs_pos > section_0_end : {0, 1};
                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_0_of_section_0 = 2 & veh___609___.next_abs_pos < 0 : {0, 1};
                   -- TODO: Only add case if lane allows traversal in that direction
                      veh___609___.is_on_sec_0 = 1 & outgoing_connection_1_of_section_0 = 2 & veh___609___.next_abs_pos > section_0_end : {0, 1};
                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_1_of_section_0 = 2 & veh___609___.next_abs_pos < 0 : {0, 1};
                   

                   

                      veh___609___.is_traversing_from_sec_0_to_sec_2 = 1 & veh___609___.lane_0 & (veh___609___.next_abs_pos > arclength_from_sec_0_to_sec_2_on_lane_0 | veh___609___.next_abs_pos < 0) : 0; -- Leave this junction when passed over the end.
                   
                   TRUE : veh___609___.is_traversing_from_sec_0_to_sec_2; -- Stay on this junction as long as not passed over the end.
                esac;
             next(veh___609___.is_traversing_from_sec_1_to_sec_2) := case
                   -- Regular switch from end of straight section to one of subsequential junctions.
                   -- TODO: Only add case if lane allows traversal in that direction
                      veh___609___.is_on_sec_1 = 1 & outgoing_connection_0_of_section_1 = 2 & veh___609___.next_abs_pos > section_1_end : {0, 1};
                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_0_of_section_1 = 2 & veh___609___.next_abs_pos < 0 : {0, 1};
                   -- TODO: Only add case if lane allows traversal in that direction
                      veh___609___.is_on_sec_1 = 1 & outgoing_connection_1_of_section_1 = 2 & veh___609___.next_abs_pos > section_1_end : {0, 1};
                      veh___609___.is_on_sec_2 = 1 & outgoing_connection_1_of_section_1 = 2 & veh___609___.next_abs_pos < 0 : {0, 1};
                   

                   

                      veh___609___.is_traversing_from_sec_1_to_sec_2 = 1 & veh___609___.lane_0 & (veh___609___.next_abs_pos > arclength_from_sec_1_to_sec_2_on_lane_0 | veh___609___.next_abs_pos < 0) : 0; -- Leave this junction when passed over the end.
                   
                   TRUE : veh___609___.is_traversing_from_sec_1_to_sec_2; -- Stay on this junction as long as not passed over the end.
                esac;
             
             
       

    
          
       INVAR (veh___609___.is_traversing_from_sec_1_to_sec_0 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_1_to_sec_0) = 1 -> veh___609___.lane_single;
       INVAR (veh___609___.is_traversing_from_sec_2_to_sec_0 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_2_to_sec_0) = 1 -> veh___609___.lane_single;
       
    INVAR (veh___609___.is_traversing_from_sec_0_to_sec_1 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_0_to_sec_1) = 1 -> veh___609___.lane_single;
       
          
       INVAR (veh___609___.is_traversing_from_sec_2_to_sec_1 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_2_to_sec_1) = 1 -> veh___609___.lane_single;
       
    INVAR (veh___609___.is_traversing_from_sec_0_to_sec_2 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_0_to_sec_2) = 1 -> veh___609___.lane_single;
       INVAR (veh___609___.is_traversing_from_sec_1_to_sec_2 = 1) -> (veh___609___.v <= 20 & veh___609___.lane_single);
          TRANS next(veh___609___.is_traversing_from_sec_1_to_sec_2) = 1 -> veh___609___.lane_single;
       
          
       
    


