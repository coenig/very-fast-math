                        angle_from_sec_0_to_sec_2 = 300 & connection_distance_sec_0_to_sec_2 = 30 : 54;
                        
                     
                     TRUE : -1;
                  esac;
               
          

       

   FROZENVAR
      section_1.source.x : 11 .. 11;
         section_1.source.y : 12 .. 12;
         section_1.angle_raw : 2 .. 2; 

         -- Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just undo!
         
            section_1_segment_0_min_lane : 0 .. 0;
            section_1_segment_0_max_lane : 0 .. 0;
            
-- EO Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just undo!

            section_1_segment_0_pos_begin : integer;
         
		 
		 section_1_end : 
		 10 .. 10; -- This is essentially the length of the section.

      FROZENVAR outgoing_connection_0_of_section_1 : -1 .. -1;         
      
               FROZENVAR outgoing_connection_1_of_section_1 : -1 .. 2;
               INIT outgoing_connection_1_of_section_1 != 1; -- Do not connect to self.
                -- Reduce topological permutations
                     
       -- Several elements can be equal, so we have at least 1 and at most 2 outgoing connections.

      

      DEFINE
         section_1.angle := section_1.angle_raw * 60;

			
					-- Fixed sin/cos times 100, since section 1 is fixed.
					sin_of_section_1_angle := 87;
					cos_of_section_1_angle := -50;
               -- sec_1_drain_x_fixed = '-38.994656'
               -- sec_1_drain_y_fixed = '98.605629'
				


         section_1.drain.x := -39;

         section_1.drain.y := 99;
         
         FROZENVAR dist_0_of_section_1_to_0 : 
                  
                         
                           -1 .. -1; -- Connection 0 of section 1 is -1, which is NOT 0. 
                        
                     
            
            FROZENVAR dist_0_of_section_1_to_2 : 
                  
                         
                           -1 .. -1; -- Connection 0 of section 1 is -1, which is NOT 2. 
                        
                     
            
         FROZENVAR dist_1_of_section_1_to_0 : 
                  
                        0 .. 30; -- "Classic" case, no implications from fixed variables.

                        INIT outgoing_connection_1_of_section_1 = 0 -> (
                              (section_0.source.x = section_1.drain.x + (dist_1_of_section_1_to_0 * (cos_of_section_1_angle + cos_of_section_0_angle)) / 100)
                              & (section_0.source.y = section_1.drain.y + (dist_1_of_section_1_to_0 * (sin_of_section_1_angle + sin_of_section_0_angle)) / 100)
                        );
                     
            
            FROZENVAR dist_1_of_section_1_to_2 : 
                  
                        0 .. 30; -- "Classic" case, no implications from fixed variables.

                        INIT outgoing_connection_1_of_section_1 = 2 -> (
                              (section_2.source.x = section_1.drain.x + (dist_1_of_section_1_to_2 * (cos_of_section_1_angle + cos_of_section_2_angle)) / 100)
                              & (section_2.source.y = section_1.drain.y + (dist_1_of_section_1_to_2 * (sin_of_section_1_angle + sin_of_section_2_angle)) / 100)
                        );
                     
            
          -- Several elements can be equal, so we have at least 1 and at most 2 outgoing connections.

         INIT ( max( abs( section_1.source.x - section_0.source.x ), abs( section_1.source.y - section_0.source.y ) ) )  
               >= 5; -- Use only farther away coordinate as lower bound.
            INIT ( max( abs( section_1.source.x - section_0.drain.x ), abs( section_1.source.y - section_0.drain.y ) ) )  
               >= 5; -- Use only farther away coordinate as lower bound.
            INIT ( max( abs( section_1.drain.x - section_0.source.x ), abs( section_1.drain.y - section_0.source.y ) ) )  
               >= 5; -- Use only farther away coordinate as lower bound.
         

         DEFINE
               angle_from_sec_1_to_sec_0_raw := section_0.angle - section_1.angle;
               angle_from_sec_1_to_sec_0 := case
                  angle_from_sec_1_to_sec_0_raw < 0 : angle_from_sec_1_to_sec_0_raw + 360;
                  angle_from_sec_1_to_sec_0_raw >= 360 : angle_from_sec_1_to_sec_0_raw - 360;
                  TRUE : angle_from_sec_1_to_sec_0_raw;
               esac;
               connection_distance_sec_1_to_sec_0 := case -- TODO: We could have several connections for the same sections with different conn. distances.
                  outgoing_connection_0_of_section_1 = 0 : dist_0_of_section_1_to_0;
                  outgoing_connection_1_of_section_1 = 0 : dist_1_of_section_1_to_0;
                  
                  TRUE : -1;
               esac;

