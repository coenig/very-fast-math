                        angle_from_sec_0_to_sec_2 = 300 & connection_distance_sec_0_to_sec_2 = 12 : 22;
                        angle_from_sec_0_to_sec_2 = 300 & connection_distance_sec_0_to_sec_2 = 13 : 23;
