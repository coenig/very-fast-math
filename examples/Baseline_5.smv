    (ego.gaps___609___.s_dist_rear >= 0 & ego.gaps___609___.s_dist_rear <= max_ego_visibility_range + 1) &
    (ego.gaps___609___.v_rear >= -max_vel & ego.gaps___609___.v_rear <= max_vel) &
