MODULE EnvModel

-- TODO: Taken over from main.tpl. Check if this makes sense or can cause trouble with C++ planner.
INIT node.em.filtered_driver_intention_dir = ActionDir____CENTER;
INIT params.enable_lane_change_driver_request = TRUE;
INIT params.enable_lanechanges = TRUE;
INIT params.slow_lane_is_on_the_right = TRUE;
INIT veh___6TEMPORARRAY19___.v = 0;

INIT !ego.flCond_full;
--INIT !ego.slCond_full;
INIT !ego.abCond_full;
-- EO TODO




 -- EM-full build

VAR
   cnt : integer;
   num_lanes : integer;
   num_technical_lanes : integer;

INIT cnt = 0;
TRANS next(cnt) = cnt + 1;

INVAR num_lanes = 1;
INVAR num_technical_lanes = 1;

------------------------------------------
--
-- Begin: Constants and common definitions
--
------------------------------------------

DEFINE
   lane_width := 400;   -- Deliberately not scaled (for now), since lateral.
   car_width := 155; -- Deliberately not scaled (for now), since lateral.
   -- The corresponding "veh_length" is below, in meter, and scaled, since long.

    ---------------- Begin of non-ego lc parameterization -----------------


    min_time_between_lcs := 1; -- after finisihing one lc, how much time needs to pass before the next one may be started
---------------- End of non-ego lc parameterization -----------------


    a_min := -8;
    a_max := 3;
    min_dist_long := -1;                            -- the minimum distance kept by other vehicle to preceding ego, we use -1 meaning one meter behind
    veh_length := 5;             -- we assume a vehicle length of 5m for distance calculation to the front per default
    max_vel := 70;

    ego.max_vel := 34; -- Leave this even in ego-less mode.
    m_j := 1;
    vel_max_j := 4;
    vel_min_j := 25;

ego.min_dist_long := veh_length;
    ego.following_dist := max(2 * ego.v, ego.min_dist_long);  -- dynamic following distance according to 2s rule (= THW)
    ego.min_accel := -8;
    ego.max_accel := 3;

    params.turn_signal_duration := 2; -- turn signals will be on for this amount of time -- TODO: Connection via vfm-aka not working, has to be investigated.
    -- total lc duration shall be 5 s according to code documentation
    -- src lane is left 1s or 2s after end of turn signal duration, tgt lane is reached after 5s
    ego.leave_src_lane_earliest_after := 1 + params.turn_signal_duration;  -- 1 s after end of turn signal duration
    ego.leave_src_lane_latest_after := 2 + params.turn_signal_duration;    -- 2 s after end of turn signal duration
    ego.complete_lane_change_earliest_after := 2 + params.turn_signal_duration;
    ego.complete_lane_change_latest_after := 2 + params.turn_signal_duration;
    -- it seems that there is no parameter given for the duration of the abort, assume same duration to roll back that it took to get to the current pos
    ego.min_time_between_lcs := 1;                      -- after finisihing one lc, how much time needs to pass before the next one may be started

    max_ego_visibility_range := 250;                      --how far can the ego sensors see? Vehicles being further away than this cannot be detected and will not be considered

    empty_gap_indicator := 0; --Counterpart to i_FREE_LANE in Viper, could be AKA-d but for now should be fine to have twice.
--------------------------------------------------------
-- End: Constants and common definitions
--------------------------------------------------------

--------------------------------------------------------
-- Sections
--  ==> Segments
--------------------------------------------------------

   DEFINE
      large_number := 10000;

   section_0_segment_1_pos_begin := section_0_segment_0_pos_begin + large_number; -- Helper variable to make below loop simpler.
   section_1_segment_1_pos_begin := section_1_segment_0_pos_begin + large_number; -- Helper variable to make below loop simpler.
   section_2_segment_1_pos_begin := section_2_segment_0_pos_begin + large_number; -- Helper variable to make below loop simpler.
   


   section_0_lane_0_availability_from_segment_1 := 0;          -- Helper variable to make below loop simpler.
   
   section_0_lane_0_availability_from_segment_0 := case
      section_0_segment_0_min_lane <= 0 & section_0_segment_0_max_lane >= 0 : section_0_lane_0_availability_from_segment_1 + section_0_segment_1_pos_begin - section_0_segment_0_pos_begin;
      TRUE: 0;
   esac;
   
   section_1_lane_0_availability_from_segment_1 := 0;          -- Helper variable to make below loop simpler.
   
   section_1_lane_0_availability_from_segment_0 := case
      section_1_segment_0_min_lane <= 0 & section_1_segment_0_max_lane >= 0 : section_1_lane_0_availability_from_segment_1 + section_1_segment_1_pos_begin - section_1_segment_0_pos_begin;
      TRUE: 0;
   esac;
   
   section_2_lane_0_availability_from_segment_1 := 0;          -- Helper variable to make below loop simpler.
   
   section_2_lane_0_availability_from_segment_0 := case
      section_2_segment_0_min_lane <= 0 & section_2_segment_0_max_lane >= 0 : section_2_lane_0_availability_from_segment_1 + section_2_segment_1_pos_begin - section_2_segment_0_pos_begin;
      TRUE: 0;
   esac;
   
   

   ego.lane_0_availability :=
   case
   ego.on_section = 0:  
         case
            ego.abs_pos >= section_0_segment_0_pos_begin : section_0_lane_0_availability_from_segment_0 + section_0_segment_0_pos_begin - ego.abs_pos;
            TRUE: 0;
         esac;
   ego.on_section = 1:  
         case
            ego.abs_pos >= section_1_segment_0_pos_begin : section_1_lane_0_availability_from_segment_0 + section_1_segment_0_pos_begin - ego.abs_pos;
            TRUE: 0;
         esac;
   ego.on_section = 2:  
         case
            ego.abs_pos >= section_2_segment_0_pos_begin : section_2_lane_0_availability_from_segment_0 + section_2_segment_0_pos_begin - ego.abs_pos;
            TRUE: 0;
         esac;
   
   esac;
   

   INIT 0 = section_0_segment_0_pos_begin;
INIT section_0_segment_0_pos_begin < section_0_end | section_0_segment_0_pos_begin = 0;


INIT section_0_segment_0_max_lane >= section_0_segment_0_min_lane;
INIT section_0_segment_0_min_lane >= 0;
INIT section_0_segment_0_max_lane <= 0;


-- Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!


INIT section_0_segment_0_max_lane >= section_0_segment_0_min_lane;
-- EO Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!

INIT 0 = section_1_segment_0_pos_begin;
INIT section_1_segment_0_pos_begin < section_1_end | section_1_segment_0_pos_begin = 0;


INIT section_1_segment_0_max_lane >= section_1_segment_0_min_lane;
INIT section_1_segment_0_min_lane >= 0;
INIT section_1_segment_0_max_lane <= 0;


-- Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!


INIT section_1_segment_0_max_lane >= section_1_segment_0_min_lane;
-- EO Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!

INIT 0 = section_2_segment_0_pos_begin;
INIT section_2_segment_0_pos_begin < section_2_end | section_2_segment_0_pos_begin = 0;


INIT section_2_segment_0_max_lane >= section_2_segment_0_min_lane;
INIT section_2_segment_0_min_lane >= 0;
INIT section_2_segment_0_max_lane <= 0;


-- Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!


INIT section_2_segment_0_max_lane >= section_2_segment_0_min_lane;
-- EO Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just delete!




--------------------------------------------------------
--  <== EO Segments
--------------------------------------------------------


   -- LOOP [sec] OVER 0..SECTIONS - 1
   FROZENVAR
      section_0.source.x : 0 .. 0;
         section_0.source.y : 0 .. 0;
         section_0.angle_raw : 0 .. 0; 

         -- Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just undo!
         
            section_0_segment_0_min_lane : 0 .. 0;
            section_0_segment_0_max_lane : 0 .. 0;
            
-- EO Special treatment for UCD, but only to achieve exact same results as in "driving by disproof." TODO: Just undo!

            section_0_segment_0_pos_begin : integer;
         
		 
		 section_0_end : 
		 10 .. 10; -- This is essentially the length of the section.

      FROZENVAR outgoing_connection_0_of_section_0 : 1 .. 1;         
      FROZENVAR outgoing_connection_1_of_section_0 : 2 .. 2;         
       -- Several elements can be equal, so we have at least 1 and at most 2 outgoing connections.

      

      DEFINE
         section_0.angle := section_0.angle_raw * 60;

			
					-- Fixed sin/cos times 100, since section 0 is fixed.
					sin_of_section_0_angle := 0;
					cos_of_section_0_angle := 100;
               -- sec_0_drain_x_fixed = '100.000000'
               -- sec_0_drain_y_fixed = '0.000000'
				


         section_0.drain.x := 100;

         section_0.drain.y := 0;
         
         
            FROZENVAR dist_0_of_section_0_to_1 : 
                  
                         
                           170
                            .. 
                            170; -- Precalculated distance since all is fixed.
                        
                     
            FROZENVAR dist_0_of_section_0_to_2 : 
                  
                         
                           -1 .. -1; -- Connection 0 of section 0 is 1, which is NOT 2. 
                        
                     
            
         
            FROZENVAR dist_1_of_section_0_to_1 : 
                  
                         
                           -1 .. -1; -- Connection 1 of section 0 is 2, which is NOT 1. 
                        
                     
            FROZENVAR dist_1_of_section_0_to_2 : 
                  
                         
                           182
                            .. 
                            182; -- Precalculated distance since all is fixed.
                        
                     
            
          -- Several elements can be equal, so we have at least 1 and at most 2 outgoing connections.

         

         
         DEFINE
               angle_from_sec_0_to_sec_1_raw := section_1.angle - section_0.angle;
               angle_from_sec_0_to_sec_1 := case
                  angle_from_sec_0_to_sec_1_raw < 0 : angle_from_sec_0_to_sec_1_raw + 360;
                  angle_from_sec_0_to_sec_1_raw >= 360 : angle_from_sec_0_to_sec_1_raw - 360;
                  TRUE : angle_from_sec_0_to_sec_1_raw;
               esac;
               connection_distance_sec_0_to_sec_1 := case -- TODO: We could have several connections for the same sections with different conn. distances.
                  outgoing_connection_0_of_section_0 = 1 : dist_0_of_section_0_to_1;
                  outgoing_connection_1_of_section_0 = 1 : dist_1_of_section_0_to_1;
                  
                  TRUE : -1;
               esac;

               arclength_from_sec_0_to_sec_1_on_lane_0 := case
                     angle_from_sec_0_to_sec_1 = 0 & connection_distance_sec_0_to_sec_1 = 0 : 0;
                        angle_from_sec_0_to_sec_1 = 0 & connection_distance_sec_0_to_sec_1 = 1 : 2;
                        angle_from_sec_0_to_sec_1 = 0 & connection_distance_sec_0_to_sec_1 = 2 : 4;
